{
  "name": "@drfed/drfed",
  "version": "0.1.0",
  "description": "The main entrypoint program for DrFed.",
  "keywords": [
    "ActivityPub",
    "fediverse",
    "federation",
    "debugger"
  ],
  "author": {
    "name": "DrFed team",
    "url": "https://drfed.org/"
  },
  "maintainers": [
    {
      "name": "ChanHaeng Lee",
      "email": "2chanhaeng@gmail.com",
      "url": "https://chomu.dev/"
    },
    {
      "name": "Hong Minhee",
      "email": "hong@minhee.org",
      "url": "https://hongminhee.org/"
    },
    {
      "name": "Hyeonseo Kim",
      "email": "dodok8@gmail.com",
      "url": "https://hackers.pub/@gaebalgom"
    },
    {
      "name": "Jiwon Kwon",
      "email": "work@kwonjiwon.org",
      "url": "https://kwonjiwon.org/"
    }
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./valueparser": {
      "types": "./dist/valueparser.d.mts",
      "default": "./dist/valueparser.mjs"
    },
    "./serving": {
      "types": "./dist/serving.d.mts",
      "default": "./dist/serving.mjs"
    },
    "./query-logger": {
      "types": "./dist/query-logger.d.mts",
      "default": "./dist/query-logger.mjs"
    },
    "./resources": {
      "types": "./dist/resources.d.mts",
      "default": "./dist/resources.mjs"
    },
    "./operations": {
      "types": "./dist/operations.d.mts",
      "default": "./dist/operations.mjs"
    },
    "./configuration": {
      "types": "./dist/configuration.d.mts",
      "default": "./dist/configuration.mjs"
    },
    "./database-settings": {
      "types": "./dist/database-settings.d.mts",
      "default": "./dist/database-settings.mjs"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.mts",
      "default": "./dist/diagnostics.mjs"
    },
    "./data-path": {
      "types": "./dist/data-path.d.mts",
      "default": "./dist/data-path.mjs"
    },
    "./postgres-settings": {
      "types": "./dist/postgres-settings.d.mts",
      "default": "./dist/postgres-settings.mjs"
    },
    "./database-runtime": {
      "types": "./dist/database-runtime.d.mts",
      "default": "./dist/database-runtime.mjs"
    },
    "./commands/migrate": {
      "types": "./dist/commands/migrate.d.mts",
      "default": "./dist/commands/migrate.mjs"
    },
    "./commands/migrate-program": {
      "types": "./dist/commands/migrate-program.d.mts",
      "default": "./dist/commands/migrate-program.mjs"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "bin": {
    "drfed-server": "bin/drfed-server.mjs",
    "drfed-migrate": "bin/drfed-migrate.mjs"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/valueparser.ts",
      "src/serving.ts",
      "src/query-logger.ts",
      "src/resources.ts",
      "src/operations.ts",
      "src/configuration.ts",
      "src/database-settings.ts",
      "src/diagnostics.ts",
      "src/data-path.ts",
      "src/postgres-settings.ts",
      "src/database-runtime.ts",
      "src/commands/migrate.ts",
      "src/commands/migrate-program.ts"
    ],
    "dts": {
      "sourcemap": true,
      "tsconfig": "../../tsconfig.drfed.json"
    },
    "sourcemap": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test"
  },
  "devDependencies": {
    "@logtape/testing-node": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@drfed/federation": "workspace:*",
    "@drfed/graphql": "workspace:*",
    "@drfed/models": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@fedify/fedify": "catalog:",
    "@fedify/pglite": "catalog:",
    "@fedify/postgres": "catalog:",
    "@logtape/drizzle-orm": "catalog:",
    "@logtape/file": "catalog:",
    "@logtape/logtape": "catalog:",
    "@optique/config": "catalog:",
    "@optique/core": "catalog:",
    "@optique/env": "catalog:",
    "@optique/logtape": "catalog:",
    "@optique/run": "catalog:",
    "@upyo/logtape": "catalog:",
    "@upyo/smtp": "catalog:",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "postgres": "catalog:",
    "smol-toml": "^1.9.1",
    "srvx": "^0.11.16",
    "valibot": "1.4.2"
  }
}
